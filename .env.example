# landit-spot-explorer 環境変数
#
#   cp .env.example .env
#
# .env が無くても docker compose up は既定値で起動します（Google キーは空 = キー無しモード）。
# compose はルートの .env を変数展開に使います。機密値を入れた .env はコミットしないでください。

# =============================================================================
# Google API キー（任意。2 本に分けて権限を分離する）
# =============================================================================
# 取得手順:
#   1. https://console.cloud.google.com/ でプロジェクトを作成し、請求先アカウントを紐づける
#   2. 「API とサービス > ライブラリ」で Maps JavaScript API と Geocoding API を有効化
#   3. 「認証情報 > 認証情報を作成 > API キー」でキーを 2 本作る
#   4. ブラウザ用: アプリ制限「ウェブサイト」に http://localhost:3000/* 、API 制限「Maps JavaScript API」のみ
#   5. サーバー用: API 制限「Geocoding API」のみ（ブラウザに出ないのでリファラ制限は付けない）

# [web] ブラウザに渡る地図表示用キー（Maps JavaScript API）。
# Server Component が実行時に読むため、変更後は `docker compose up -d web` で反映（再ビルド不要）。
# 空なら地図の代わりに「キー未設定」の案内パネルを表示し、リスト・住所表示は動作する。
GOOGLE_MAPS_BROWSER_KEY=

# [api] サーバー側の逆ジオコーディング用キー（Geocoding API のみ有効化）。ブラウザには出ない。
# 空なら国土地理院（GSI）の逆ジオコーダに自動フォールバックする。
GOOGLE_GEOCODING_API_KEY=

# =============================================================================
# db（postgis/postgis:16-3.4）
# =============================================================================
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=spots

# =============================================================================
# api（NestJS）
# =============================================================================
# 接続先 DB。※ docker compose では使われない（compose は POSTGRES_* から
#   postgres://<user>:<pass>@db:5432/<db> を組み立てて api に渡す）。
#   backend をホストで直接動かす（npm run start:dev）ときの値。
DATABASE_URL=postgres://app:app@localhost:5432/spots

# 待ち受けポート。※ compose ではコンテナ内 3001 固定（healthcheck・web の転送先と揃えるため）
PORT=3001

# CORS 許可オリジン。ブラウザは web 経由（同一オリジン /api/...）で叩くため通常は不要だが、
# API を直接ブラウザから叩く開発時のために web のオリジンを許可しておく
CORS_ORIGIN=http://localhost:3000

# 逆ジオ結果キャッシュ（geocode_cache）の有効期間（日）
GEOCODE_CACHE_TTL_DAYS=30

# 逆ジオのキャッシュキーにする座標の丸め桁数。3 = 小数第 3 位（緯度 約111m / 経度 約91m のグリッド）
# api と web の両方がこの値を読む（フロントの「微小移動では再検索しない」判定とサーバーのキャッシュ粒度を揃える）
GEOCODE_GRID_DECIMALS=3

# =============================================================================
# web（Next.js）
# =============================================================================
# src/proxy.ts がリクエストごとにこの値を読み、/api/:path* をこの URL に転送する（サーバー側のみで使用。
# ビルド時には固定されないので、同じイメージのまま .env だけで切り替えられる）。
# ※ docker compose では使われない（compose は http://api:3001 を固定で渡す）。
#   frontend をホストで直接動かす（npm run dev）ときの値。
API_URL=http://localhost:3001
